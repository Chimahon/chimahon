CREATE TABLE anime_saved_search(
    _id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    name TEXT NOT NULL,
    query TEXT,
    filters_json TEXT
);

CREATE TABLE anime_feed_saved_search (
    _id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    saved_search INTEGER,
    global INTEGER AS Boolean NOT NULL,
    feed_order INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(saved_search) REFERENCES anime_saved_search (_id)
    ON DELETE CASCADE
);

CREATE INDEX anime_feed_saved_search_saved_search_index ON anime_feed_saved_search(saved_search);
