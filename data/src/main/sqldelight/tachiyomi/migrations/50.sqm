CREATE TABLE IF NOT EXISTS novel_reading_stats(
    _id INTEGER NOT NULL PRIMARY KEY,
    novel_id INTEGER NOT NULL,
    date_key TEXT NOT NULL,
    characters_read INTEGER NOT NULL DEFAULT 0,
    reading_time REAL NOT NULL DEFAULT 0,
    min_reading_speed INTEGER NOT NULL DEFAULT 0,
    alt_min_reading_speed INTEGER NOT NULL DEFAULT 0,
    last_reading_speed INTEGER NOT NULL DEFAULT 0,
    max_reading_speed INTEGER NOT NULL DEFAULT 0,
    completed_book INTEGER,
    UNIQUE(novel_id, date_key),
    FOREIGN KEY(novel_id) REFERENCES novels(_id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS novel_reading_stats_novel_id_index ON novel_reading_stats(novel_id);
CREATE INDEX IF NOT EXISTS novel_reading_stats_date_key_index ON novel_reading_stats(date_key);

CREATE TABLE IF NOT EXISTS novel_extension_repos (
    base_url TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    short_name TEXT,
    website TEXT NOT NULL,
    signing_key_fingerprint TEXT UNIQUE NOT NULL
);
