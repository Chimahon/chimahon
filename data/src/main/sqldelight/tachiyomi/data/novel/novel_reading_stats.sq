CREATE TABLE novel_reading_stats(
    _id INTEGER NOT NULL PRIMARY KEY,
    novel_id INTEGER NOT NULL,
    date_key TEXT NOT NULL,
    characters_read INTEGER NOT NULL DEFAULT 0,
    reading_time REAL NOT NULL DEFAULT 0,
    min_reading_speed INTEGER NOT NULL DEFAULT 0,
    alt_min_reading_speed INTEGER NOT NULL DEFAULT 0,
    last_reading_speed INTEGER NOT NULL DEFAULT 0,
    max_reading_speed INTEGER NOT NULL DEFAULT 0,
    completed_book INTEGER,
    UNIQUE(novel_id, date_key),
    FOREIGN KEY(novel_id) REFERENCES novels(_id) ON DELETE CASCADE
);

CREATE INDEX novel_reading_stats_novel_id_index ON novel_reading_stats(novel_id);
CREATE INDEX novel_reading_stats_date_key_index ON novel_reading_stats(date_key);

upsertNovelReadingStats:
INSERT INTO novel_reading_stats(novel_id, date_key, characters_read, reading_time, min_reading_speed, alt_min_reading_speed, last_reading_speed, max_reading_speed, completed_book)
VALUES (:novelId, :dateKey, :charactersRead, :readingTime, :minReadingSpeed, :altMinReadingSpeed, :lastReadingSpeed, :maxReadingSpeed, :completedBook)
ON CONFLICT(novel_id, date_key)
DO UPDATE SET
    characters_read = characters_read + :charactersRead,
    reading_time = reading_time + :readingTime,
    min_reading_speed = min_reading_speed,
    alt_min_reading_speed = alt_min_reading_speed,
    last_reading_speed = :lastReadingSpeed,
    max_reading_speed = max(max_reading_speed, :maxReadingSpeed),
    completed_book = coalesce(:completedBook, completed_book)
WHERE novel_reading_stats.novel_id = :novelId AND novel_reading_stats.date_key = :dateKey;

getNovelStatsByNovelId:
SELECT *
FROM novel_reading_stats
WHERE novel_id = :novelId
ORDER BY date_key;

getAllNovelStats:
SELECT *
FROM novel_reading_stats;

getNovelStatsForDay:
SELECT *
FROM novel_reading_stats
WHERE date_key = :dateKey;

deleteNovelStatsByNovelId:
DELETE FROM novel_reading_stats
WHERE novel_id = :novelId;
