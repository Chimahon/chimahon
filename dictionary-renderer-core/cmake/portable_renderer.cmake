set(DC_DEPENDENCIES "${CMAKE_CURRENT_SOURCE_DIR}/../tools/native-dictionary/.deps" CACHE PATH "Native renderer dependency sources")
set(BUILD_SHARED_LIBS OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(SKIP_INSTALL_ALL ON)
set(HB_BUILD_UTILS OFF CACHE BOOL "" FORCE)
set(HB_BUILD_SUBSET OFF CACHE BOOL "" FORCE)
set(HB_HAVE_FREETYPE OFF CACHE BOOL "" FORCE)
set(HB_HAVE_ICU OFF CACHE BOOL "" FORCE)
set(HB_HAVE_GLIB OFF CACHE BOOL "" FORCE)
add_subdirectory("${DC_DEPENDENCIES}/harfbuzz" portable-harfbuzz EXCLUDE_FROM_ALL)
set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
set(zlib "${DC_DEPENDENCIES}/zlib")
configure_file("${zlib}/zconf.h.in" "${CMAKE_CURRENT_BINARY_DIR}/portable-zlib/zconf.h" COPYONLY)
# zlib's upstream CMake creates an unwanted shared Android library as well.
add_library(zlibstatic STATIC ${zlib}/adler32.c ${zlib}/compress.c ${zlib}/crc32.c
    ${zlib}/deflate.c ${zlib}/inflate.c ${zlib}/infback.c ${zlib}/inftrees.c
    ${zlib}/inffast.c ${zlib}/trees.c ${zlib}/uncompr.c ${zlib}/zutil.c)
target_include_directories(zlibstatic PUBLIC "${zlib}" "${CMAKE_CURRENT_BINARY_DIR}/portable-zlib")
if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS zlibstatic)
endif()
set(ZLIB_LIBRARY zlibstatic CACHE STRING "" FORCE)
set(ZLIB_INCLUDE_DIR "${DC_DEPENDENCIES}/zlib" CACHE PATH "" FORCE)
set(PNG_SHARED OFF CACHE BOOL "" FORCE)
set(PNG_STATIC ON CACHE BOOL "" FORCE)
set(PNG_TESTS OFF CACHE BOOL "" FORCE)
set(PNG_TOOLS OFF CACHE BOOL "" FORCE)
add_subdirectory("${DC_DEPENDENCIES}/libpng" portable-png EXCLUDE_FROM_ALL)
if(NOT TARGET PNG::PNG)
    add_library(PNG::PNG ALIAS png_static)
endif()
set(PNG_LIBRARY png_static CACHE STRING "" FORCE)
set(PNG_PNG_INCLUDE_DIR "${DC_DEPENDENCIES}/libpng" CACHE PATH "" FORCE)
set(FT_DISABLE_PNG OFF CACHE BOOL "" FORCE)
set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
add_subdirectory("${DC_DEPENDENCIES}/freetype" portable-freetype EXCLUDE_FROM_ALL)
add_library(dc_bidi STATIC "${DC_DEPENDENCIES}/sheenbidi/Source/SheenBidi.c")
target_include_directories(dc_bidi PUBLIC "${DC_DEPENDENCIES}/sheenbidi/Headers")
target_include_directories(dc_bidi PRIVATE "${DC_DEPENDENCIES}/sheenbidi/Source")
target_compile_definitions(dc_bidi PRIVATE SB_CONFIG_UNITY)
set(unibreak "${DC_DEPENDENCIES}/libunibreak/src")
add_library(dc_breaks STATIC ${unibreak}/unibreakbase.c ${unibreak}/unibreakdef.c
    ${unibreak}/linebreak.c ${unibreak}/linebreakdata.c ${unibreak}/linebreakdef.c
    ${unibreak}/eastasianwidthdef.c ${unibreak}/emojidef.c)
target_sources(dc_breaks PRIVATE ${unibreak}/graphemebreak.c)
target_include_directories(dc_breaks PUBLIC "${unibreak}")
set(agg "${CMAKE_CURRENT_SOURCE_DIR}/third_party/agg")
add_library(dc_raster STATIC ${agg}/src/agg_curves.cpp ${agg}/src/agg_trans_affine.cpp
    ${agg}/src/agg_rounded_rect.cpp ${agg}/src/agg_bezier_arc.cpp
    ${agg}/src/agg_arc.cpp ${agg}/src/agg_sqrt_tables.cpp)
target_include_directories(dc_raster PUBLIC "${agg}/include")
set(PLUTOVG_ENABLE_IMAGE_WRITE OFF CACHE BOOL "" FORCE)
set(PLUTOVG_DISABLE_FONT_FACE_CACHE_LOAD ON CACHE BOOL "" FORCE)
add_subdirectory("${DC_DEPENDENCIES}/plutovg" portable-color EXCLUDE_FROM_ALL)
target_sources(dictionary_core PRIVATE src/portable_renderer.cpp src/portable_color_glyph.cpp)
target_link_libraries(dictionary_core PRIVATE harfbuzz freetype dc_bidi dc_breaks dc_raster plutovg)
target_compile_definitions(dictionary_core PRIVATE DC_PORTABLE_RENDERER=1)
if(ANDROID)
    foreach(target harfbuzz freetype dc_bidi dc_breaks dc_raster plutovg png_static zlibstatic)
        target_compile_options(${target} PRIVATE -O3 -ffunction-sections -fdata-sections -fvisibility=hidden)
        target_compile_definitions(${target} PRIVATE NDEBUG)
    endforeach()
endif()
if(NOT MSVC)
    # AGG predates C++17 and still uses the removed `register` keyword.
    target_compile_options(dc_raster PRIVATE -Wno-register)
    target_compile_options(dictionary_core PRIVATE -Wno-register)
endif()
